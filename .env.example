# 百炼 DashScope（LLM + Embedding，OpenAI 兼容端点）
DASHSCOPE_API_KEY=sk-***
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=qwen3.7-text-embedding-flash

# 视觉理解：默认 AI Ping 平台豆包（OpenAI 兼容），可换其他 VL 服务
VL_API_KEY=sk-***
VL_BASE_URL=https://aiping.cn/api/v1
VL_MODEL=doubao-2.1-pro          # 批量处理可切 doubao-2.1-flash

# Scraper
XHS_COOKIES=your_cookies_here
SCRAPER_RATE_LIMIT=0.5           # 请求/秒（≈2s 间隔）
XHS_MCP_URL=http://localhost:18060  # 可选：本地 xiaohongshu-mcp

# Knowledge
TOP_K_RETRIEVAL=5

# Agent
COMPANION_MODEL=qwen-turbo
COMPANION_TEMPERATURE=0.8
