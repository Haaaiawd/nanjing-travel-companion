# 百炼 API
DASHSCOPE_API_KEY=sk-***
DASHSCOPE_API_KEY_FALLBACK=sk-***
OPENAI_COMPATIBLE_URL=https://your-endpoint/compatible-mode/v1
DASHSCOPE_BASE_URL=https://your-endpoint/api/v1

# Embedding
EMBEDDING_MODEL=qwen3.7-text-embedding-flash

# OCR
VL_API_KEY=sk-***
VL_BASE_URL=https://your-endpoint/compatible-mode/v1
VL_MODEL=qwen-vl-max

# Scraper
XHS_COOKIES=your_cookies_here
SCRAPER_RATE_LIMIT=2  # 每秒请求数

# Knowledge
CHUNK_MAX_TOKENS=500
TOP_K_RETRIEVAL=5

# Agent
COMPANION_MODEL=qwen-turbo
COMPANION_TEMPERATURE=0.8
